# ResolveAI Configuration
PROJECT_NAME="ResolveAI — Intelligent IT Incident Management & SLA Prediction Platform"
VERSION="1.0.0"
SECRET_KEY="resolveai-super-secret-jwt-key-college-major-project-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Default: Zero-friction SQLite (local development)
DATABASE_URL="sqlite:///./resolveai.db"
# Optional PostgreSQL Connection:
# DATABASE_URL="postgresql://resolveai_user:resolveai_pass@localhost:5432/resolveai_db"

# SLA Default Target Resolution Hours
SLA_CRITICAL_HOURS=4
SLA_HIGH_HOURS=8
SLA_MEDIUM_HOURS=24
SLA_LOW_HOURS=72

# SLA Warning Alert Thresholds (percentage consumed)
SLA_WARNING_THRESHOLD_PERCENT=75.0
SLA_CRITICAL_THRESHOLD_PERCENT=90.0

# Duplicate Similarity Cutoff (0.0 to 1.0)
DUPLICATE_SIMILARITY_THRESHOLD=0.35
